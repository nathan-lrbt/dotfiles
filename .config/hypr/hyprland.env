#!/usr/bin/env bash
# hyprland global environment for dark mode & consistent cursor

# gtk (gtk3 & gtk4) dark theme
export gtk_theme=Adwaita:dark
export gtk_application_prefer_dark_theme=1

# cursor theme & size
export xcursor_theme=adwaita
export xcursor_size=24

# qt apps follow gtk theme
export qt_qpa_platformtheme=gtk

# force gdk scaling/dpi consistency
export gdk_scale=1
export gdk_dpi_scale=1

# optional: set default desktop name
export xdg_current_desktop=hyprland

# GTK2
export GTK2_RC_FILES="$HOME/.config/gtk-2.0/gtkrc"

# remove env prefix in prompt
export CONDA_CHANGEPS1=false
