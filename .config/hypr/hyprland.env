#!/usr/bin/env bash
# === Global environment for dark mode & consistent UI ===

# --- Theme ---
export GTK_THEME=Catppuccin-Mauve-Dark-Macchiato
export GTK_APPLICATION_PREFER_DARK_THEME=1
export XDG_CURRENT_DESKTOP=Hyprland

# --- Cursor ---
export XCURSOR_THEME=phinger-cursors-dark
export XCURSOR_SIZE=24

# --- GTK2 Support ---
export GTK2_RC_FILES="$HOME/.config/gtk-2.0/gtkrc"

# --- Qt (use GTK theme) ---
export QT_QPA_PLATFORMTHEME=gtk
export QT_STYLE_OVERRIDE=Adwaita-dark

# --- GDK scaling / DPI ---
export GDK_SCALE=1
export GDK_DPI_SCALE=1

# --- Ensure apps launched from launchers follow this ---
export DESKTOP_SESSION=hyprland

# remove env prefix in prompt
export CONDA_CHANGEPS1=false
